{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": false,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@/*": ["./*"],
			"@components/*": ["./components/*"],
			"@utils/*": ["./utils/*"],
			"@services/*": ["./services/*"]
		}
	},
	"include": ["vite-env.d.ts", "src", "**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "vitest.config.ts", "vitest.setup.ts", "out", "tests"]
}
